@startuml
scale 1.0
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 180
top to bottom direction

title Thiet ke chi tiet goi cua doi tuong Nguoi dung

package "Presentation" {
  class LoginPage
  class RegisterPage
  class PrivateRoute
  class UserManagementPage
}

package "Application" {
  class UserService
}

package "Data Access" {
  interface UserRepository
  interface CustomerRepository
  interface AuthRepository
}

package "Data" {
  class User
  class Customer
}

LoginPage ..> UserService
RegisterPage ..> UserService
PrivateRoute ..> UserService
UserManagementPage ..> UserService
UserService ..> UserRepository
UserService ..> CustomerRepository
UserService ..> AuthRepository
UserRepository ..> User
CustomerRepository ..> Customer

@enduml
