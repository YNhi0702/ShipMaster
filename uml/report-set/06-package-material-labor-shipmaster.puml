@startuml
scale 1.0
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 180
top to bottom direction

title Thiet ke chi tiet goi cua doi tuong Vat tu va Nhan cong

package "Presentation" {
  class ProposalInspectorPage
  class OrderInfoPage
  class OrderDetailDonePage
  class InventoryManagementPage
  class StaffManagementPage
}

package "Application" {
  class MaterialLaborService
}

package "Data Access" {
  interface MaterialRepository
  interface RepairOrderMaterialRepository
  interface RepairOrderLaborRepository
  interface EmployeeRepository
}

package "Data" {
  class Material
  class RepairOrderMaterial
  class RepairOrderLabor
  class Employee
}

ProposalInspectorPage ..> MaterialLaborService
OrderInfoPage ..> MaterialLaborService
OrderDetailDonePage ..> MaterialLaborService
InventoryManagementPage ..> MaterialLaborService
StaffManagementPage ..> MaterialLaborService
MaterialLaborService ..> MaterialRepository
MaterialLaborService ..> RepairOrderMaterialRepository
MaterialLaborService ..> RepairOrderLaborRepository
MaterialLaborService ..> EmployeeRepository
MaterialRepository ..> Material
RepairOrderMaterialRepository ..> RepairOrderMaterial
RepairOrderLaborRepository ..> RepairOrderLabor
EmployeeRepository ..> Employee

@enduml
