@startuml
scale 1.0
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam dpi 180
autonumber

title Bieu do trinh tu cho ca su dung Ghi nhan thanh toan

actor Accountant
participant PaymentList
participant Firestore

Accountant -> PaymentList : Mo danh sach hoa don
PaymentList -> Firestore : Lay invoice va payment
Firestore --> PaymentList : Danh sach hoa don
Accountant -> PaymentList : Chon hoa don va nhap so tien
PaymentList -> PaymentList : Kiem tra du lieu
PaymentList -> Firestore : Tao payment
Firestore --> PaymentList : OK
PaymentList -> Firestore : Cap nhat invoice
Firestore --> PaymentList : OK
PaymentList --> Accountant : Thong bao thanh cong

@enduml
