@startuml
scale 0.95
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 180
left to right direction

title Bieu do lop cho cac chuc nang lien quan den Nguoi dung

class Login {
  - loading : boolean
  + onFinish(values) : Promise<void>
}

class Register {
  - loading : boolean
  + onFinish(values) : Promise<void>
}

class PrivateRoute {
  - userRole : string
  - allowedRoles : string[]
  + fetchUserRole() : Promise<void>
}

class UserManagement {
  - users : UserData[]
  + fetchUsers() : Promise<void>
  + handleOk() : Promise<void>
  + handleDelete(id) : Promise<void>
}

class FirebaseService {
  + signIn() : UserCredential
  + createUser() : UserCredential
  + getUserDoc() : DocumentSnapshot
}

Login ..> FirebaseService
Register ..> FirebaseService
PrivateRoute ..> FirebaseService
UserManagement ..> FirebaseService

@enduml
