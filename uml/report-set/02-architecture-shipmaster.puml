@startuml
scale 1.0
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam dpi 180
top to bottom direction

title Kien truc tong the he thong ShipMaster

rectangle "Client" {
  actor Customer
  actor Inspector
  actor WorkshopOwner
  actor Accountant
  actor Director
}

rectangle "Front-end\nReact + TypeScript" {
  rectangle "Pages / Components" as UI
  rectangle "PrivateRoute / Layout" as RouteGuard
}

rectangle "Firebase Services" {
  rectangle "Authentication" as Auth
  rectangle "Cloud Firestore" as Firestore
  rectangle "Cloud Storage" as Storage
  rectangle "Cloud Functions" as Functions
}

rectangle "Data Collections" {
  rectangle "users / customers / employees" as C1
  rectangle "ship / workShop / repairOrder" as C2
  rectangle "material / invoice / payment" as C3
}

Customer --> UI
Inspector --> UI
WorkshopOwner --> UI
Accountant --> UI
Director --> UI

UI --> RouteGuard
RouteGuard --> Auth
RouteGuard --> Firestore
UI --> Firestore
UI --> Storage
UI --> Functions
Functions --> Auth
Functions --> Firestore

Firestore --> C1
Firestore --> C2
Firestore --> C3

@enduml
