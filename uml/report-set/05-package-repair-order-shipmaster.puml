@startuml
scale 1.0
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 180
top to bottom direction

title Thiet ke chi tiet goi cua doi tuong Don sua chua

package "Presentation" {
  class CreateOrderPage
  class CustomerHomePage
  class OrderDetailPage
  class InspectorHomePage
  class OrderDetailInspectorPage
  class WorkshopHomePage
  class OrderInfoPage
}

package "Application" {
  class RepairOrderService
}

package "Data Access" {
  interface RepairOrderRepository
  interface ShipRepository
  interface WorkshopRepository
}

package "Data" {
  class RepairOrder
  class Ship
  class WorkShop
}

CreateOrderPage ..> RepairOrderService
CustomerHomePage ..> RepairOrderService
OrderDetailPage ..> RepairOrderService
InspectorHomePage ..> RepairOrderService
OrderDetailInspectorPage ..> RepairOrderService
WorkshopHomePage ..> RepairOrderService
OrderInfoPage ..> RepairOrderService
RepairOrderService ..> RepairOrderRepository
RepairOrderService ..> ShipRepository
RepairOrderService ..> WorkshopRepository
RepairOrderRepository ..> RepairOrder
ShipRepository ..> Ship
WorkshopRepository ..> WorkShop

@enduml
